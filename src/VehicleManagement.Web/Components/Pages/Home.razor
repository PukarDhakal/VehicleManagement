@page "/"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using VehicleManagement.Application.Categories
@using VehicleManagement.Application.Vehicles
@using VehicleManagement.Domain
@using VehicleManagement.Domain.Vehicles
@inject VehicleApplicationService VehicleService
@inject TimeProvider TimeProvider
@inject ILogger<Home> Logger

<PageTitle>Vehicle Management</PageTitle>

<main class="vehicle-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">CreditWorks vehicle register</p>
            <h1>Vehicle Management</h1>
            <p class="introduction">
                Add vehicles and see their current category based on weight.
            </p>
        </div>
        <div class="vehicle-total" aria-label="@(_hasLoadedVehicles ? "Total vehicles" : "Vehicle count unavailable")">
            <strong>@(_hasLoadedVehicles ? _vehicles.Count.ToString() : "—")</strong>
            <span>@(!_hasLoadedVehicles ? "list unavailable" : _vehicles.Count == 1 ? "vehicle" : "vehicles")</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_manufacturerErrorMessage))
    {
        <div class="message error-message" role="alert">@_manufacturerErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_saveErrorMessage))
    {
        <div class="message error-message" role="alert">@_saveErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_saveMessage))
    {
        <div class="message @(_saveMessageIsWarning ? "warning-message" : "success-message")" role="status">@_saveMessage</div>
    }

    <div class="content-grid">
        <section class="panel create-panel" aria-labelledby="create-heading">
            <div class="panel-heading">
                <div>
                    <h2 id="create-heading">Add a vehicle</h2>
                    <p>Record the vehicle details below.</p>
                </div>
            </div>

            <EditForm Model="_form"
                      OnValidSubmit="CreateVehicleAsync"
                      FormName="create-vehicle"
                      novalidate>
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="owner-name">Owner name</label>
                    <InputText id="owner-name" @bind-Value="_form.OwnerName" maxlength="150" />
                </div>

                <div class="form-field">
                    <label for="manufacturer">Manufacturer</label>
                    <InputSelect id="manufacturer" @bind-Value="_form.ManufacturerId">
                        <option value="0">Select a manufacturer</option>
                        @foreach (var manufacturer in _manufacturers)
                        {
                            <option value="@manufacturer.Id">@manufacturer.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label for="manufacture-year">Year of manufacture</label>
                        <InputNumber id="manufacture-year"
                                     @bind-Value="_form.YearOfManufacture"
                                     min="1800"
                                     max="@(_currentYear + 1)"
                                     ParsingErrorMessage="Enter a valid manufacture year." />
                    </div>

                    <div class="form-field">
                        <label for="vehicle-weight">Weight in kilograms</label>
                        <InputNumber id="vehicle-weight"
                                     @bind-Value="_form.WeightKg"
                                     min="0.01"
                                     max="99999999.99"
                                     step="0.01"
                                     ParsingErrorMessage="Enter a valid positive weight." />
                    </div>
                </div>

                <button class="primary-button" type="submit" disabled="@(_isSaving || _isLoading || _manufacturerErrorMessage is not null)">
                    @(_isSaving ? "Saving..." : "Add vehicle")
                </button>

                <div class="form-validation-summary" aria-live="polite">
                    <ValidationSummary />
                </div>
            </EditForm>
        </section>

        <section class="panel list-panel" aria-labelledby="vehicles-heading">
            <div class="panel-heading list-heading">
                <div class="heading-copy">
                    <div>
                        <h2 id="vehicles-heading">Registered vehicles</h2>
                        <p>Categories are calculated from the current weight boundaries.</p>
                    </div>
                </div>

                <div class="sort-controls" aria-label="Vehicle sorting controls">
                    <label for="sort-field">Sort by</label>
                    <select id="sort-field" @bind="_sortField">
                        <option value="@VehicleSortField.OwnerName">Owner</option>
                        <option value="@VehicleSortField.Manufacturer">Manufacturer</option>
                        <option value="@VehicleSortField.YearOfManufacture">Year</option>
                        <option value="@VehicleSortField.WeightKg">Weight</option>
                    </select>

                    <label class="direction-control">
                        <input type="checkbox" @bind="_descending" />
                        Descending
                    </label>

                    <button class="secondary-button" type="button" @onclick="RefreshVehiclesAsync" disabled="@(_isLoading || _isSaving)">
                        Apply
                    </button>
                </div>
            </div>

            @if (_isLoading)
            {
                <p class="empty-state" role="status">Loading vehicles...</p>
            }
            else if (_listErrorMessage is not null)
            {
                <p class="empty-state list-error-state" role="alert">@_listErrorMessage</p>
            }
            else if (_vehicles.Count == 0)
            {
                <p class="empty-state">No vehicles have been added yet.</p>
            }
            else
            {
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Owner</th>
                                <th scope="col">Manufacturer</th>
                                <th scope="col">Year</th>
                                <th scope="col">Weight</th>
                                <th scope="col">Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in _vehicles)
                            {
                                <tr>
                                    <td data-label="Owner">@vehicle.OwnerName</td>
                                    <td data-label="Manufacturer">@vehicle.ManufacturerName</td>
                                    <td data-label="Year">@vehicle.YearOfManufacture</td>
                                    <td data-label="Weight">@vehicle.WeightKg.ToString("N2") kg</td>
                                    <td data-label="Category">
                                        <span class="category-badge">
                                            <span aria-hidden="true">@GetCategoryIcon(vehicle.CategoryIconKey)</span>
                                            @vehicle.CategoryName
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</main>

@code {
    private static readonly TimeSpan SuccessNoticeDuration = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan ErrorNoticeDuration = TimeSpan.FromSeconds(8);

    private IReadOnlyList<Manufacturer> _manufacturers = Array.Empty<Manufacturer>();
    private IReadOnlyList<VehicleListItem> _vehicles = Array.Empty<VehicleListItem>();
    private VehicleFormModel _form = new();
    private VehicleSortField _sortField = VehicleSortField.OwnerName;
    private bool _descending;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasLoadedVehicles;
    private bool _saveMessageIsWarning;
    private int _currentYear;
    private string? _manufacturerErrorMessage;
    private string? _saveErrorMessage;
    private string? _saveMessage;
    private string? _listErrorMessage;
    private CancellationTokenSource? _noticeCancellation;

    protected override async Task OnInitializedAsync()
    {
        _currentYear = TimeProvider.GetUtcNow().Year;
        _form.CurrentYear = _currentYear;
        _form.YearOfManufacture = _currentYear;

        try
        {
            _manufacturers = await VehicleService.GetManufacturersAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load manufacturers.");
            _manufacturerErrorMessage = exception is DbException
                ? "Manufacturer choices could not be loaded from the database. Check that SQL Server is running and database setup completed, then reload the page."
                : "Manufacturer choices are unavailable, so vehicles cannot be added right now. Reload the page to try again.";
        }

        await LoadVehiclesAsync();
    }

    private async Task CreateVehicleAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        ClearSaveNotice();

        try
        {
            var request = new CreateVehicleRequest(
                _form.OwnerName,
                _form.ManufacturerId,
                _form.YearOfManufacture,
                _form.WeightKg);

            await VehicleService.CreateVehicleAsync(request);
            _form = new VehicleFormModel
            {
                CurrentYear = _currentYear,
                YearOfManufacture = _currentYear
            };

            if (await LoadVehiclesAsync())
            {
                ShowSaveMessage("Vehicle added successfully. The registered vehicles list is up to date.");
            }
            else
            {
                ShowSaveMessage("Vehicle saved, but the registered vehicles list could not be refreshed. Select Apply to retry.", warning: true);
            }
        }
        catch (DomainValidationException exception)
        {
            ShowSaveError(exception.Message);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to create a vehicle.");
            ShowSaveError(exception is DbException
                ? "The database did not confirm whether the vehicle was saved. Check that SQL Server is running, then check the vehicle list before trying again. Your form has been kept."
                : "The vehicle save could not be confirmed. Your form has been kept. Check the vehicle list before trying again; if the problem continues, contact an administrator.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RefreshVehiclesAsync()
    {
        if (!_saveMessageIsWarning)
        {
            ClearSaveNotice();
        }

        if (await LoadVehiclesAsync() && _saveMessageIsWarning)
        {
            ShowSaveMessage("Vehicle added successfully. The registered vehicles list is up to date.");
        }
    }

    private void ShowSaveMessage(string message, bool warning = false)
    {
        ClearSaveNotice();
        _saveMessage = message;
        _saveMessageIsWarning = warning;
        ScheduleNoticeDismissal(warning ? ErrorNoticeDuration : SuccessNoticeDuration);
    }

    private void ShowSaveError(string message)
    {
        ClearSaveNotice();
        _saveErrorMessage = message;
        ScheduleNoticeDismissal(ErrorNoticeDuration);
    }

    private void ClearSaveNotice()
    {
        _noticeCancellation?.Cancel();
        _noticeCancellation = null;
        _saveErrorMessage = null;
        _saveMessage = null;
        _saveMessageIsWarning = false;
    }

    private void ScheduleNoticeDismissal(TimeSpan duration)
    {
        var cancellation = new CancellationTokenSource();
        _noticeCancellation = cancellation;
        _ = DismissNoticeAsync(duration, cancellation);
    }

    private async Task DismissNoticeAsync(TimeSpan duration, CancellationTokenSource cancellation)
    {
        try
        {
            await Task.Delay(duration, cancellation.Token);
            await InvokeAsync(() =>
            {
                if (_noticeCancellation != cancellation)
                {
                    return;
                }

                _noticeCancellation = null;
                _saveErrorMessage = null;
                _saveMessage = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            cancellation.Dispose();
        }
    }

    public void Dispose() => ClearSaveNotice();

    private async Task<bool> LoadVehiclesAsync()
    {
        _isLoading = true;
        _listErrorMessage = null;

        try
        {
            _vehicles = await VehicleService.GetVehiclesAsync(_sortField, _descending);
            _hasLoadedVehicles = true;
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load vehicles.");
            _vehicles = Array.Empty<VehicleListItem>();
            _hasLoadedVehicles = false;
            _listErrorMessage = GetListErrorMessage(exception);
            return false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetListErrorMessage(Exception exception)
    {
        return exception switch
        {
            CategoryConfigurationMissingException =>
                "Vehicle categories have not been set up yet. Ask an administrator to complete category setup before loading the list.",
            DomainValidationException =>
                "A saved vehicle cannot be classified with the current category rules. Ask an administrator to check its weight and the category boundaries.",
            DbException =>
                "The database could not load the vehicle list. Check that SQL Server is running and database setup completed, then select Apply to retry.",
            _ =>
                "The registered vehicles list is unavailable right now. Select Apply to retry. If the problem continues, contact an administrator."
        };
    }

    private static string GetCategoryIcon(string iconKey)
    {
        switch (iconKey)
        {
            case "car":
                return "🚗";
            case "van":
                return "🚐";
            case "truck":
                return "🚚";
            default:
                return "●";
        }
    }

    private sealed class VehicleFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Please enter a valid name.")]
        [StringLength(150, ErrorMessage = "Please enter a valid name.")]
        [RegularExpression(
            Vehicle.OwnerNamePattern,
            ErrorMessage = "Please enter a valid name.")]
        public string OwnerName { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Select a manufacturer.")]
        public int ManufacturerId { get; set; }

        public int CurrentYear { get; set; }

        [Range(1800, 9999, ErrorMessage = "Enter a year from 1800 onwards.")]
        public int YearOfManufacture { get; set; }

        public decimal WeightKg { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var latestAllowedYear = CurrentYear + 1;
            if (YearOfManufacture > latestAllowedYear)
            {
                yield return new ValidationResult(
                    $"Enter a year no later than {latestAllowedYear}.",
                    new[] { nameof(YearOfManufacture) });
            }

            if (WeightKg <= 0)
            {
                yield return new ValidationResult(
                    "Weight must be greater than 0 kg.",
                    new[] { nameof(WeightKg) });
            }
            else if (WeightKg > 99_999_999.99m)
            {
                yield return new ValidationResult(
                    "Weight cannot exceed 99,999,999.99 kg.",
                    new[] { nameof(WeightKg) });
            }
            else if (decimal.Round(WeightKg, 2) != WeightKg)
            {
                yield return new ValidationResult(
                    "Weight can have no more than two decimal places.",
                    new[] { nameof(WeightKg) });
            }
        }
    }
}
