{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vehicle Management: Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/src/VehicleManagement.Web/bin/Debug/net10.0/VehicleManagement.Web.dll",
      "cwd": "${workspaceFolder}/src/VehicleManagement.Web",
      "launchSettingsProfile": "http",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
